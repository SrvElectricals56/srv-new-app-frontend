{
  "name": "srv-expo-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "eas-build-pre-install": "node scripts/validate-google-signin-config.cjs",
    "start": "expo start",
    "start:clear": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "e2e:staging": "node scripts/staging-e2e.mjs",
    "test:audit": "node --test scripts/mobile-audit.test.cjs",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@pushpendersingh/react-native-otp-verify": "^1.2.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.11",
    "expo-auth-session": "~58.0.17",
    "expo-awesome-app-icon": "^2.2.1",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-mail-composer": "~58.0.3",
    "expo-notifications": "~58.1.8",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "fast-png": "^6.2.0",
    "jsqr": "^1.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-razorpay": "^3.0.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.8.3",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.0",
    "minimatch": "10.2.6",
    "postcss": "8.5.25",
    "uuid": "11.1.1"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-razorpay"
        ]
      }
    }
  }
}
