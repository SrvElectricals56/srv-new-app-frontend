{
  "expo": {
    "name": "SRV Electricals",
    "slug": "srv-electricals",
    "scheme": "srv-electricals",
    "version": "2.0.0",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SRV Electricals to access only the photos you choose for profile, document, and support uploads.",
          "cameraPermission": "Allow SRV Electricals to use your camera when you choose to take a photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SRV Electricals to access your camera so you can scan QR codes and capture product images."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SRV Electricals to access your location so we can fill your current address during signup.",
          "locationWhenInUsePermission": "Allow SRV Electricals to access your location so we can fill your current address during signup."
        }
      ],
      "expo-mail-composer",
      "expo-notifications",
      "expo-web-browser",
      "expo-video",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.519956418767-use4fj4rpt9i7e49dmakrga9v3a2b41s"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F5F0E8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.srvelectricals.app",
      "buildNumber": "27"
    },
    "android": {
      "versionCode": 30,
      "allowBackup": false,
      "googleServicesFile": "./android/app/google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F5F0E8"
      },
      "package": "com.srvelectricals.app"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3accb457-f3fd-46d2-aaad-da153822265f"
      }
    },
    "owner": "srv_electricals"
  }
}
